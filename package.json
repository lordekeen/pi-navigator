{
  "name": "@lordekeen/pi-navigator",
  "version": "0.18.3",
  "description": "Read-only project file navigator overlay for pi: file tree, git state, and syntax-highlighted viewing without leaving the session.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "navigator",
    "file-tree",
    "file-viewer",
    "git",
    "tui",
    "terminal-ui",
    "overlay"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lordekeen/pi-navigator.git"
  },
  "homepage": "https://github.com/lordekeen/pi-navigator#readme",
  "bugs": "https://github.com/lordekeen/pi-navigator/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "index.ts",
    "navigator.ts",
    "session.ts",
    "tree.ts",
    "git.ts",
    "viewer.ts",
    "diff.ts",
    "icons.ts",
    "env.ts",
    "theme.ts",
    "types.ts",
    "constants.ts",
    "settings.ts",
    "settings_menu.ts",
    "help.ts",
    "chafa.ts",
    "native_image.ts",
    "image_pipeline.ts",
    "images.ts",
    "frame.ts",
    "layout.ts",
    "files_view.ts",
    "git_view.ts",
    "help_view.ts",
    "ansi.ts",
    "bytes.ts",
    "open_target.ts",
    "viewer_view.ts",
    "viewer_model.ts",
    "minimap_view.ts",
    "assets/",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/lordekeen/pi-navigator/main/assets/files-git-viewer.png",
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
