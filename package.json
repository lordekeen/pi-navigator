{
  "name": "pi-navigator",
  "version": "0.6.0",
  "description": "Read-only project file navigator overlay for pi: file tree, git state, and syntax-highlighted viewing without leaving the session.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "navigator",
    "file-tree",
    "file-viewer",
    "git",
    "tui",
    "terminal-ui",
    "overlay"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "index.ts",
    "navigator.ts",
    "tree.ts",
    "git.ts",
    "viewer.ts",
    "diff.ts",
    "icons.ts",
    "theme.ts",
    "types.ts",
    "constants.ts",
    "settings.ts",
    "images.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
